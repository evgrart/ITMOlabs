<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/itmo/wh40k"
         xmlns="https://example.org/itmo/wh40k#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="https://example.org/itmo/wh40k">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ЛР1: Warhammer 40,000. Исходные 25 унарных и 15 бинарных фактов из knowledge_base.pl. Семь Prolog-правил переведены в OWL-определения и три SWRL-клаузы. Открытый мир сохраняется; полнота psyker указана только для шести известных персонажей.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.warhammer-community.com/en-gb/articles/cIZhIO0L/13-black-crusades-and-now-the-arks-of-omen-is-abaddon-warhammer-40000s-biggest-bad/</rdfs:seeAlso>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.warhammer-community.com/en-gb/articles/PB264l6v/welcome-your-new-necron-overlords/</rdfs:seeAlso>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#belongsTo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Faction"/>
  <owl:inverseOf rdf:resource="#hasMember"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">связан с фракцией</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMember">
  <rdfs:domain rdf:resource="#Faction"/>
  <rdfs:range rdf:resource="#Character"/>
  <owl:inverseOf rdf:resource="#belongsTo"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">имеет представителя</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hostileFaction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Faction"/>
  <rdfs:range rdf:resource="#Faction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">конфликт фракций</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Три выбранных конфликта учебного сценария. Отсутствие связи не означает канонический мир.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enemyOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Character"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">враг в сценарии</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#allyOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Character"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">союзник в сценарии</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебное допущение: разные персонажи Империума либо Хаоса могут сотрудничать; не правило состава настольной армии. Ксеносы не объединены в один союз.</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#threatRating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">учебный рейтинг угрозы</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Условный учебный рейтинг 0..10; не официальный профиль, очки или сравнение силы персонажей из лора.</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Entity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сущность</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Character">
  <rdfs:subClassOf rdf:resource="#Entity"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#belongsTo"/>
      <owl:onClass rdf:resource="#Faction"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#threatRating"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#Faction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Персонаж</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Faction">
  <rdfs:subClassOf rdf:resource="#Entity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фракция</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ImperialFaction">
  <rdfs:subClassOf rdf:resource="#Faction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фракция Империума</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ChaosFaction">
  <rdfs:subClassOf rdf:resource="#Faction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фракция Хаоса</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#XenosFaction">
  <rdfs:subClassOf rdf:resource="#Faction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фракция ксеносов</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Psyker">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:disjointWith rdf:resource="#NonPsyker"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Псайкер</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Commander">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Военачальник</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выбранные военачальники учебной модели; список не претендует на полноту лора.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ImperialCharacter">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#belongsTo"/>
          <owl:someValuesFrom rdf:resource="#ImperialFaction"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Персонаж Империума</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ChaosCharacter">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#belongsTo"/>
          <owl:someValuesFrom rdf:resource="#ChaosFaction"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Персонаж Хаоса</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#XenosCharacter">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#belongsTo"/>
          <owl:someValuesFrom rdf:resource="#XenosFaction"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Персонаж ксеносов</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DangerousCharacter">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Psyker"/>
            <rdf:Description rdf:about="#Commander"/>
          </owl:unionOf>
        </owl:Class>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#threatRating"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Опасный персонаж (учебный критерий)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NonPsyker">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Class>
          <owl:complementOf rdf:resource="#Psyker"/>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Не-псайкер</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отрицательный тип Psyker задан только для известных не-псайкеров; неизвестный Character не классифицируется по отсутствию факта.</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#ultramarines">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#ImperialFaction"/>
  <hostileFaction rdf:resource="#black_legion"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ультрамарины</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#blood_angels">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#ImperialFaction"/>
  <hostileFaction rdf:resource="#thousand_sons"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кровавые Ангелы</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#black_legion">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#ChaosFaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чёрный Легион</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#thousand_sons">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#ChaosFaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тысяча Сынов</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#aeldari">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#XenosFaction"/>
  <hostileFaction rdf:resource="#necrons"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аэльдари</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#necrons">
  <rdf:type rdf:resource="#Faction"/>
  <rdf:type rdf:resource="#XenosFaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Некроны</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#roboute_guilliman">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Commander"/>
  <belongsTo rdf:resource="#ultramarines"/>
  <rdf:type>
    <owl:Class>
      <owl:complementOf rdf:resource="#Psyker"/>
    </owl:Class>
  </rdf:type>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Робаут Жиллиман</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#mephiston">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Psyker"/>
  <belongsTo rdf:resource="#blood_angels"/>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мефистон</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#abaddon">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Commander"/>
  <belongsTo rdf:resource="#black_legion"/>
  <rdf:type>
    <owl:Class>
      <owl:complementOf rdf:resource="#Psyker"/>
    </owl:Class>
  </rdf:type>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Абаддон</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ahriman">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Psyker"/>
  <rdf:type rdf:resource="#Commander"/>
  <belongsTo rdf:resource="#thousand_sons"/>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ариман</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#eldrad_ulthran">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Psyker"/>
  <belongsTo rdf:resource="#aeldari"/>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эльдрад Ультран</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#imotekh">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Commander"/>
  <belongsTo rdf:resource="#necrons"/>
  <rdf:type>
    <owl:Class>
      <owl:complementOf rdf:resource="#Psyker"/>
    </owl:Class>
  </rdf:type>
  <threatRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</threatRating>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Имотех</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#enemies_rule">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Character"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#Character"/>
              <swrl:argument1 rdf:resource="urn:swrl#y"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#belongsTo"/>
                  <swrl:argument1 rdf:resource="urn:swrl#x"/>
                  <swrl:argument2 rdf:resource="urn:swrl#f"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#belongsTo"/>
                      <swrl:argument1 rdf:resource="urn:swrl#y"/>
                      <swrl:argument2 rdf:resource="urn:swrl#g"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#hostileFaction"/>
                          <swrl:argument1 rdf:resource="urn:swrl#f"/>
                          <swrl:argument2 rdf:resource="urn:swrl#g"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DifferentIndividualsAtom>
                              <swrl:argument1 rdf:resource="urn:swrl#x"/>
                              <swrl:argument2 rdf:resource="urn:swrl#y"/>
                            </swrl:DifferentIndividualsAtom>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#enemyOf"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
          <swrl:argument2 rdf:resource="urn:swrl#y"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Character(?x), Character(?y), belongsTo(?x, ?f), belongsTo(?y, ?g), hostileFaction(?f, ?g), DifferentFrom(?x, ?y) -&gt; enemyOf(?x, ?y)</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#imperial_allies_rule">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ImperialCharacter"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#ImperialCharacter"/>
              <swrl:argument1 rdf:resource="urn:swrl#y"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DifferentIndividualsAtom>
                  <swrl:argument1 rdf:resource="urn:swrl#x"/>
                  <swrl:argument2 rdf:resource="urn:swrl#y"/>
                </swrl:DifferentIndividualsAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#allyOf"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
          <swrl:argument2 rdf:resource="urn:swrl#y"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImperialCharacter(?x), ImperialCharacter(?y), DifferentFrom(?x, ?y) -&gt; allyOf(?x, ?y)</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#chaos_allies_rule">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ChaosCharacter"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
